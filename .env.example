# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role / secret key (bypasses RLS). Server-side only, never ship it to a browser or app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=restaurants

# upsert = insert new + update existing (needs the unique index in supabase/migration.sql)
# update = only update rows that already exist
SYNC_MODE=upsert

# Proxy pool, comma/newline separated. Formats: http://user:pass@host:port | host:port | host:port:user:pass
PROXY_LIST=
# Also use this machine's own IP as one member of the pool (always used if PROXY_LIST is empty)
ALLOW_DIRECT=false

# Crawl tuning
MAX_PAGES=5

# Delays (milliseconds). Slower = fewer blocked IPs.
<<<<<<< Updated upstream
# Simplest knob: wait at least this many seconds before every fetch (0 = use the ranges below).
# Same effect as `npm run place -- --delay 8`.
FETCH_DELAY_SEC=0
# Random wait before EVERY request
=======
# Random wait before EVERY request.
# npm run dinealign uses 10000-15000 when these two are left unset.
>>>>>>> Stashed changes
MIN_DELAY_MS=2500
MAX_DELAY_MS=6000
# The same proxy IP is never reused sooner than this
PROXY_MIN_GAP_MS=8000
# Long break every N requests (0 disables)
BREAK_EVERY=25
BREAK_MIN_MS=30000
BREAK_MAX_MS=90000
# Pause between listing pages (e.g. Koramangala delivery -> Koramangala dine-out)
LISTING_DELAY_MIN_MS=10000
LISTING_DELAY_MAX_MS=25000
# Extra wait after a block before retrying on the next proxy
BLOCK_PAUSE_MS=20000
# Random 0..N delay before the run starts, so the daily job doesn't hit Zomato at the exact same second
START_JITTER_MAX_MS=0
# Sessions (proxies) to try per listing before giving up; defaults to min(pool size + 1, 6)
# MAX_ATTEMPTS=4
